.table-container {
  background: white;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  overflow: hidden;
}

.table-header {
  background-color: #f8fafc;
  padding: 12px;
  border-bottom: 1px solid #e2e8f0;
  text-align: center;
}

.table-header h4 {
  margin: 0;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12px;
  border-bottom: 1px solid #f1f5f9;
}

.row:last-child { border-bottom: none; }

.subject-name {
  font-weight: 600;
  display: block;
}

.online-text { color: var(--accent-green); }

.btn-live {
  width: calc(100% - 20px);
  margin: 10px;
  padding: 10px;
  background-color: var(--accent-blue);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: bold;
  cursor: pointer;
}